---
import Layout from '../components/Layout.astro';
---

<Layout title="页面不存在 · 外链手册" description="该页面已下线或不存在，请返回外链列表。">
	<h1 class="text-xl font-semibold">404</h1>
	<p class="mt-2 text-sm text-[var(--site-muted)]">
		该页面已下线或不存在。
		<a href={import.meta.env.BASE_URL} class="text-[var(--site-text)] underline underline-offset-4">返回外链列表</a>
	</p>
</Layout>
