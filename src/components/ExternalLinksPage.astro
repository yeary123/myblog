---
import Layout from './Layout.astro';
import LinkLibrary from './links/LinkLibrary';
import '../styles/link-library.css';
---

<Layout title="外链手册" description="575 个外链平台的简明说明，按免费、收费和个人标签浏览、记录笔记，并按天记录发布外链的工作与成果。" lang="zh-CN" canonicalPath={import.meta.env.BASE_URL}>
  <LinkLibrary client:load />
  <noscript>请启用 JavaScript，使用外链搜索、标签编辑和外链日志功能。</noscript>
</Layout>
